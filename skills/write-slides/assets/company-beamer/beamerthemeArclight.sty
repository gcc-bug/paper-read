\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeArclight}[2026/10/12 Arclight company presentation theme]
\RequirePackage{graphicx}
\RequirePackage{tikz}

\mode<presentation>

% Proposed theme tokens, sampled from the supplied logo's rendered PDF.
% These are not official company brand specifications.
\definecolor{ArclightRed}{HTML}{E7211B}
\definecolor{ArclightInk}{HTML}{231916}
\definecolor{ArclightMuted}{HTML}{49433F}
\definecolor{ArclightRule}{HTML}{DDD8D5}
\definecolor{ArclightPale}{HTML}{F7F5F4}
\definecolor{ArclightAlert}{HTML}{B91C17}

\newcommand{\arclightlogopath}{brand/logo.pdf}
\newcommand{\arclightcompanyname}{Arclight}
\newcommand{\arclightsetlogo}[1]{\renewcommand{\arclightlogopath}{#1}}
\newcommand{\arclightsetcompany}[1]{\renewcommand{\arclightcompanyname}{#1}}
\newcommand{\arclightlogographic}[1]{%
  \includegraphics[width=#1]{\arclightlogopath}}

\setbeamercolor{normal text}{fg=ArclightInk,bg=white}
\setbeamercolor{structure}{fg=ArclightInk}
\setbeamercolor{frametitle}{fg=ArclightInk,bg=white}
\setbeamercolor{framesubtitle}{fg=ArclightMuted}
\setbeamercolor{title}{fg=ArclightInk}
\setbeamercolor{subtitle}{fg=ArclightMuted}
\setbeamercolor{alerted text}{fg=ArclightAlert}
\setbeamercolor{block title}{fg=ArclightInk,bg=ArclightPale}
\setbeamercolor{block body}{fg=ArclightInk,bg=ArclightPale}
\setbeamercolor{block title alerted}{fg=ArclightAlert,bg=ArclightPale}
\setbeamercolor{block body alerted}{fg=ArclightInk,bg=ArclightPale}
\setbeamercolor{footline}{fg=ArclightMuted,bg=white}
\setbeamercolor{itemize item}{fg=ArclightRed}
\setbeamercolor{itemize subitem}{fg=ArclightMuted}

\usefonttheme{professionalfonts}
\setbeamerfont{title}{size=\fontsize{25}{30},series=\bfseries}
\setbeamerfont{subtitle}{size=\normalsize,series=\mdseries}
\setbeamerfont{frametitle}{size=\fontsize{18}{23},series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{11}{14},series=\mdseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{footline}{size=\fontsize{8}{10},series=\mdseries}
\setbeamerfont{section in head/foot}{size=\fontsize{8}{10},series=\mdseries}
\setbeamercolor{section in head/foot}{fg=ArclightInk,bg=white}
\setbeamertemplate{section in head/foot}{\color{ArclightRed}\bfseries\insertsectionhead}
\setbeamertemplate{section in head/foot shaded}{\color{ArclightMuted}\insertsectionhead}
\setbeamersize{text margin left=9mm,text margin right=9mm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{.2ex}{\scriptsize$\bullet$}}
\setbeamertemplate{itemize subitem}{\raisebox{.2ex}{\tiny$\bullet$}}
\setbeamertemplate{blocks}[default]
\setbeamertemplate{bibliography item}[text]
\setlength{\parskip}{2mm}

% Reserve a separate right-hand zone for the logo, so titles can wrap safely.
\setbeamertemplate{frametitle}{%
  \vskip4mm%
  \begin{beamercolorbox}[wd=\textwidth,sep=0pt]{frametitle}
    \begin{minipage}[t]{\dimexpr\textwidth-28mm\relax}
      \vspace{0pt}\raggedright\usebeamerfont{frametitle}\insertframetitle\par
      \ifx\insertframesubtitle\@empty\else
        \vskip1mm{\usebeamerfont{framesubtitle}%
          \usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
      \fi
    \end{minipage}\hfill%
    \begin{minipage}[t]{22mm}
      \vspace{0pt}\raggedleft\arclightlogographic{22mm}
    \end{minipage}\par
    \vskip2mm
    {\color{ArclightRed}\rule{12mm}{.65pt}}%
    {\color{ArclightRule}\rule{\dimexpr\textwidth-12mm\relax}{.35pt}}
  \end{beamercolorbox}
  \vskip2mm%
}

% Native Beamer section ranges are restored from .nav on subsequent passes.
% Progress counts PDF pages within the current section (including overlays).
\newlength{\arclightprogresswidth}
\newlength{\arclightcontentwidth}
\setlength{\arclightcontentwidth}{\dimexpr\paperwidth-18mm\relax}
\newcommand{\arclightsectionposition}{%
  \ifnum\c@section>0\relax
    \the\numexpr\insertpagenumber-\insertsectionstartpage+1\relax
    \,/\,\the\numexpr\insertsectionendpage-\insertsectionstartpage+1\relax
  \fi}
\newcommand{\arclightprogressbar}{%
  \pgfmathsetlength{\arclightprogresswidth}{0pt}%
  \ifnum\c@section>0\relax
    \pgfmathsetlength{\arclightprogresswidth}{\arclightcontentwidth *
      min(1,max(0,(\insertpagenumber-\insertsectionstartpage+1)/
      max(1,\insertsectionendpage-\insertsectionstartpage+1)))}%
  \fi
  \rlap{\color{ArclightRule}\rule{\arclightcontentwidth}{.65pt}}%
  {\color{ArclightRed}\rule{\arclightprogresswidth}{.65pt}}}

\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3mm,dp=.5mm,%
      leftskip=9mm,rightskip=9mm]{footline}
    \insertsectionnavigationhorizontal{\arclightcontentwidth}{}{}%
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=\paperwidth,ht=.6mm,dp=.4mm,%
      leftskip=9mm,rightskip=9mm]{footline}
    \arclightprogressbar
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3mm,dp=2mm,%
      leftskip=9mm,rightskip=9mm]{footline}
    \usebeamerfont{footline}%
    \begin{minipage}[b]{.68\arclightcontentwidth}
      \raggedright\arclightcompanyname\quad|\quad\insertshorttitle
    \end{minipage}\hfill\arclightsectionposition\quad|\quad\insertframenumber
  \end{beamercolorbox}%
}

% Place after the cover, before the first section. Appendix is a separate part.
\newcommand{\arclightagenda}[1]{%
  \begin{frame}[label=arclight-agenda]{#1}
    \tableofcontents[hideallsubsections]
  \end{frame}%
}

\setbeamertemplate{title page}{%
  \vskip3mm
  \arclightlogographic{42mm}\par
  \vskip8mm
  {\color{ArclightRed}\rule{15mm}{1.2pt}}\par
  \vskip3mm
  \begin{minipage}{.93\textwidth}
    \raggedright{\usebeamerfont{title}\inserttitle\par}
    \vskip3mm
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
  \end{minipage}
  \vfill
  {\normalsize\insertauthor\par}
  {\small\color{ArclightMuted}\insertinstitute\quad|\quad\insertdate\par}
}

% Optional section/closing frame; the user chooses where it helps the talk.
\newcommand{\arclightdivider}[2]{%
  \begin{frame}[plain]
    \vspace{3mm}
    \arclightlogographic{30mm}\par
    \vfill
    {\color{ArclightRed}\rule{15mm}{1.2pt}}\par
    \vspace{3mm}
    {\LARGE\bfseries #1\par}
    \vspace{3mm}
    {\normalsize\color{ArclightMuted}#2\par}
    \vfill
  \end{frame}%
}

\mode<all>
